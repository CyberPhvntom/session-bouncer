#!/bin/bash

# session-bouncr v2.0 - Enhanced Security Monitoring
# Features: IP tracking, session limits, multi-intruder detection, stealth mode

# === CONFIGURATION SECTION - CUSTOMIZE THIS ===

# Authorized users with expected IPs (use "any" to allow any IP)
declare -A AUTHORIZED_USERS
AUTHORIZED_USERS["root"]="any"
AUTHORIZED_USERS["score1"]="any"
AUTHORIZED_USERS["score2"]="any"
AUTHORIZED_USERS["angel"]="any"
AUTHORIZED_USERS["Angel"]="any"
AUTHORIZED_USERS["Theodore"]="any"
AUTHORIZED_USERS["Affan"]="any"
AUTHORIZED_USERS["William"]="any"
AUTHORIZED_USERS["Deep"]="any"
AUTHORIZED_USERS["Syed"]="any"

# Maximum concurrent sessions per user (0 = unlimited)
declare -A MAX_SESSIONS
MAX_SESSIONS["root"]=5
MAX_SESSIONS["score1"]=3
MAX_SESSIONS["score2"]=3
MAX_SESSIONS["angel"]=3
MAX_SESSIONS["Angel"]=3
MAX_SESSIONS["Theodore"]=3
MAX_SESSIONS["Affan"]=3
MAX_SESSIONS["William"]=3
MAX_SESSIONS["Deep"]=3
MAX_SESSIONS["Syed"]=3

# Monitoring settings
CHECK_INTERVAL=2              # Seconds between checks
AUTO_KICK_UNAUTHORIZED=false  # true = auto-kick, false = prompt
AUTO_KICK_SUSPICIOUS=false    # Auto-kick suspicious authorized users
LOG_FILE="/var/log/session_guard.log"
ALERT_SOUND=true
STEALTH_MODE=false           # Hides output, only logs

# === END CONFIGURATION ===

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# Track detected intruders for batch processing
declare -a INTRUDERS
declare -a SUSPICIOUS_SESSIONS

# === LOGGING FUNCTIONS ===

log_event() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | sudo tee -a "$LOG_FILE" > /dev/null
}

alert_sound() {
    if $ALERT_SOUND; then
        echo -ne '\007' 2>/dev/null
    fi
}

# === VALIDATION FUNCTIONS ===

is_authorized_user() {
    local username=$1
    [[ -n "${AUTHORIZED_USERS[$username]}" ]]
}

get_expected_ip() {
    local username=$1
    echo "${AUTHORIZED_USERS[$username]}"
}

get_max_sessions() {
    local username=$1
    echo "${MAX_SESSIONS[$username]:-0}"
}

# Extract IP from who output (handles various formats)
extract_ip() {
    local who_line=$1
    # Extract IP from parentheses or return "local" if none
    if [[ "$who_line" =~ \(([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)\) ]]; then
        echo "${BASH_REMATCH[1]}"
    elif [[ "$who_line" =~ \(([a-zA-Z0-9.-]+)\) ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo "local"
    fi
}

# === SESSION ANALYSIS ===

get_user_sessions() {
    local username=$1
    who | awk -v user="$username" '$1 == user {print $2"|"$5}' | wc -l
}

analyze_session() {
    local username=$1
    local tty=$2
    local ip=$3
    local suspicious=false
    local reason=""
    
    # Check 1: Is user authorized at all?
    if ! is_authorized_user "$username"; then
        return 2  # Unauthorized user
    fi
    
    # Check 2: IP validation
    local expected_ip=$(get_expected_ip "$username")
    if [[ "$expected_ip" != "any" ]] && [[ "$ip" != "$expected_ip" ]]; then
        suspicious=true
        reason="Unexpected IP: $ip (expected: $expected_ip)"
    fi
    
    # Check 3: Session count limit
    local max_sessions=$(get_max_sessions "$username")
    if [[ $max_sessions -gt 0 ]]; then
        local current_sessions=$(get_user_sessions "$username")
        if [[ $current_sessions -gt $max_sessions ]]; then
            suspicious=true
            reason="${reason:+$reason; }Session limit exceeded: $current_sessions/$max_sessions"
        fi
    fi
    
    if $suspicious; then
        return 1  # Suspicious session
    fi
    
    return 0  # Normal session
}

# === TERMINATION FUNCTIONS ===

terminate_session() {
    local username=$1
    local tty=$2
    local method=${3:-"all"}  # all, tty, or user
    
    case $method in
        tty)
            sudo pkill -KILL -t "$tty" 2>/dev/null
            ;;
        user)
            sudo pkill -KILL -u "$username" 2>/dev/null
            ;;
        all|*)
            # Use multiple methods for thorough termination
            sudo pkill -KILL -t "$tty" 2>/dev/null
            sudo pkill -KILL -u "$username" 2>/dev/null
            
            # Also use loginctl if available
            if command -v loginctl &> /dev/null; then
                local sessions=$(loginctl list-sessions --no-legend 2>/dev/null | grep "$username" | awk '{print $1}')
                for session in $sessions; do
                    sudo loginctl terminate-session "$session" 2>/dev/null
                done
            fi
            ;;
    esac
    
    log_event "TERMINATED: User '$username' on TTY '$tty' (method: $method)"
}

terminate_all_intruders() {
    if [[ ${#INTRUDERS[@]} -eq 0 ]]; then
        return
    fi
    
    echo -e "\n${RED}╔════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║  TERMINATING ALL UNAUTHORIZED SESSIONS            ║${NC}"
    echo -e "${RED}╚════════════════════════════════════════════════════╝${NC}\n"
    
    for intruder in "${INTRUDERS[@]}"; do
        IFS='|' read -r username tty ip <<< "$intruder"
        echo -e "${RED}[✗]${NC} Kicking out: $username ($tty from $ip)"
        terminate_session "$username" "$tty" "all"
    done
    
    echo -e "\n${GREEN}[✓] All unauthorized users have been terminated.${NC}\n"
    INTRUDERS=()
}

terminate_suspicious_sessions() {
    if [[ ${#SUSPICIOUS_SESSIONS[@]} -eq 0 ]]; then
        return
    fi
    
    echo -e "\n${YELLOW}╔════════════════════════════════════════════════════╗${NC}"
    echo -e "${YELLOW}║  TERMINATING SUSPICIOUS SESSIONS                  ║${NC}"
    echo -e "${YELLOW}╚════════════════════════════════════════════════════╝${NC}\n"
    
    for suspicious in "${SUSPICIOUS_SESSIONS[@]}"; do
        IFS='|' read -r username tty ip reason <<< "$suspicious"
        echo -e "${YELLOW}[!]${NC} Kicking out: $username ($tty from $ip)"
        echo -e "    Reason: $reason"
        terminate_session "$username" "$tty" "all"
    done
    
    echo -e "\n${GREEN}[✓] All suspicious sessions have been terminated.${NC}\n"
    SUSPICIOUS_SESSIONS=()
}

# === MONITORING FUNCTIONS ===

scan_sessions() {
    INTRUDERS=()
    SUSPICIOUS_SESSIONS=()
    local all_clear=true
    
    # Get all logged-in users
    while IFS= read -r line; do
        local username=$(echo "$line" | awk '{print $1}')
        local tty=$(echo "$line" | awk '{print $2}')
        local ip=$(extract_ip "$line")
        
        [[ -z "$username" ]] && continue
        
        # Analyze this session
        analyze_session "$username" "$tty" "$ip"
        local status=$?
        
        case $status in
            2)  # Unauthorized user
                INTRUDERS+=("$username|$tty|$ip")
                log_event "ALERT: Unauthorized user '$username' on TTY '$tty' from '$ip'"
                all_clear=false
                ;;
            1)  # Suspicious session
                local reason=""
                local expected_ip=$(get_expected_ip "$username")
                if [[ "$expected_ip" != "any" ]] && [[ "$ip" != "$expected_ip" ]]; then
                    reason="Unexpected IP: $ip (expected: $expected_ip)"
                fi
                local max_sessions=$(get_max_sessions "$username")
                if [[ $max_sessions -gt 0 ]]; then
                    local current=$(get_user_sessions "$username")
                    if [[ $current -gt $max_sessions ]]; then
                        reason="${reason:+$reason; }Session limit: $current/$max_sessions"
                    fi
                fi
                SUSPICIOUS_SESSIONS+=("$username|$tty|$ip|$reason")
                log_event "WARNING: Suspicious session '$username' on TTY '$tty' from '$ip' - $reason"
                all_clear=false
                ;;
            0)  # Normal session
                ;;
        esac
    done < <(who)
    
    return $([ "$all_clear" = true ] && echo 0 || echo 1)
}

display_alert() {
    if $STEALTH_MODE; then
        return
    fi
    
    clear
    
    # Display unauthorized users
    if [[ ${#INTRUDERS[@]} -gt 0 ]]; then
        alert_sound
        echo -e "${RED}╔════════════════════════════════════════════════════╗${NC}"
        echo -e "${RED}║           UNAUTHORIZED USERS DETECTED!             ║${NC}"
        echo -e "${RED}╚════════════════════════════════════════════════════╝${NC}\n"
        
        for intruder in "${INTRUDERS[@]}"; do
            IFS='|' read -r username tty ip <<< "$intruder"
            echo -e "${RED}[✗] INTRUDER:${NC}"
            echo -e "    Username: ${RED}$username${NC}"
            echo -e "    TTY:      $tty"
            echo -e "    From:     $ip"
            echo -e "    Time:     $(date '+%H:%M:%S')"
            echo ""
        done
    fi
    
    # Display suspicious sessions
    if [[ ${#SUSPICIOUS_SESSIONS[@]} -gt 0 ]]; then
        alert_sound
        echo -e "${YELLOW}╔════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║          SUSPICIOUS SESSIONS DETECTED              ║${NC}"
        echo -e "${YELLOW}╚════════════════════════════════════════════════════╝${NC}\n"
        
        for suspicious in "${SUSPICIOUS_SESSIONS[@]}"; do
            IFS='|' read -r username tty ip reason <<< "$suspicious"
            echo -e "${YELLOW}[!] SUSPICIOUS:${NC}"
            echo -e "    Username: ${YELLOW}$username${NC}"
            echo -e "    TTY:      $tty"
            echo -e "    From:     $ip"
            echo -e "    Reason:   $reason"
            echo -e "    Time:     $(date '+%H:%M:%S')"
            echo ""
        done
    fi
}

handle_threats() {
    local has_intruders=$([[ ${#INTRUDERS[@]} -gt 0 ]] && echo true || echo false)
    local has_suspicious=$([[ ${#SUSPICIOUS_SESSIONS[@]} -gt 0 ]] && echo true || echo false)
    
    # Handle unauthorized users
    if $has_intruders; then
        if $AUTO_KICK_UNAUTHORIZED; then
            terminate_all_intruders
        else
            echo -e "${RED}Terminate all unauthorized users?${NC} [Y/n/i(gnore once)]: "
            read -t 15 -n 1 response
            echo ""
            
            case "$response" in
                [Yy]|"")
                    terminate_all_intruders
                    ;;
                [Ii])
                    echo -e "${YELLOW}[~] Ignoring unauthorized users (this check only)${NC}"
                    INTRUDERS=()
                    ;;
                *)
                    echo -e "${YELLOW}[~] Skipped termination${NC}"
                    ;;
            esac
        fi
    fi
    
    # Handle suspicious sessions
    if $has_suspicious; then
        if $AUTO_KICK_SUSPICIOUS; then
            terminate_suspicious_sessions
        else
            echo -e "${YELLOW}Terminate suspicious sessions?${NC} [y/N/i(gnore once)]: "
            read -t 15 -n 1 response
            echo ""
            
            case "$response" in
                [Yy])
                    terminate_suspicious_sessions
                    ;;
                [Ii])
                    echo -e "${YELLOW}[~] Ignoring suspicious sessions (this check only)${NC}"
                    SUSPICIOUS_SESSIONS=()
                    ;;
                *)
                    echo -e "${YELLOW}[~] Skipped termination${NC}"
                    ;;
            esac
        fi
    fi
}

show_status() {
    if $STEALTH_MODE; then
        return
    fi
    
    echo -e "\n${CYAN}════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}Current Active Sessions:${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════════${NC}\n"
    
    local session_count=0
    while IFS= read -r line; do
        local username=$(echo "$line" | awk '{print $1}')
        local tty=$(echo "$line" | awk '{print $2}')
        local ip=$(extract_ip "$line")
        
        [[ -z "$username" ]] && continue
        ((session_count++))
        
        analyze_session "$username" "$tty" "$ip"
        local status=$?
        
        case $status in
            2)  # Unauthorized
                echo -e "${RED}✗${NC} $username\t$tty\t$ip ${RED}[UNAUTHORIZED]${NC}"
                ;;
            1)  # Suspicious
                echo -e "${YELLOW}!${NC} $username\t$tty\t$ip ${YELLOW}[SUSPICIOUS]${NC}"
                ;;
            0)  # Normal
                echo -e "${GREEN}✓${NC} $username\t$tty\t$ip"
                ;;
        esac
    done < <(who)
    
    if [[ $session_count -eq 0 ]]; then
        echo -e "${YELLOW}No active sessions detected${NC}"
    fi
    
    echo -e "\n${CYAN}════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}[$(date '+%H:%M:%S')]${NC} Monitoring... (Ctrl+C to stop)"
    echo ""
}

show_banner() {
    if $STEALTH_MODE; then
        return
    fi
    
    clear
    echo -e "${BLUE}"
    echo "╔════════════════════════════════════════════════════╗"
    echo "║         SESSION-BOUNCR v2.0 - ENHANCED             ║"
    echo "║       Advanced Intrusion Detection System          ║"
    echo "╚════════════════════════════════════════════════════╝"
    echo -e "${NC}"
    echo -e "${GREEN}Features:${NC}"
    echo "  • IP address validation"
    echo "  • Session count monitoring"
    echo "  • Multi-intruder detection"
    echo "  • Batch termination"
    echo ""
    echo -e "${CYAN}Authorized Users:${NC} ${!AUTHORIZED_USERS[@]}"
    echo -e "${CYAN}Check Interval:${NC} ${CHECK_INTERVAL}s"
    echo -e "${CYAN}Auto-kick Unauthorized:${NC} $AUTO_KICK_UNAUTHORIZED"
    echo -e "${CYAN}Auto-kick Suspicious:${NC} $AUTO_KICK_SUSPICIOUS"
    echo ""
    echo -e "${YELLOW}Started:${NC} $(date)"
    echo "Press Ctrl+C to stop"
    echo "════════════════════════════════════════════════════"
    sleep 2
}

# === MAIN MONITORING LOOP ===

main() {
    # Check for root
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}Error: This script must be run with sudo${NC}"
        echo "Usage: sudo $0"
        exit 1
    fi
    
    # Create log file
    touch "$LOG_FILE" 2>/dev/null
    chmod 640 "$LOG_FILE" 2>/dev/null
    
    # Start monitoring
    show_banner
    log_event "Session Guard v2.0 started (PID: $$)"
    
    while true; do
        scan_sessions
        local threats_found=$?
        
        if [[ $threats_found -eq 1 ]]; then
            display_alert
            handle_threats
        fi
        
        show_status
        sleep "$CHECK_INTERVAL"
    done
}

# Trap signals
trap 'echo -e "\n${YELLOW}Session-Bouncr stopped.${NC}"; log_event "Monitoring stopped"; exit 0' INT TERM

# Self-restart if killed unexpectedly
trap 'log_event "Unexpected termination - restarting..."; exec "$0" "$@"' HUP

# Run main
main
